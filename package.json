{
  "name": "algotracker",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watchAll",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "build-prod": "eas build --profile production"
  },
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    },
    "testPathIgnorePatterns": [
      "/node_modules/"
    ]
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@openspacelabs/react-native-zoomable-view": "2.4.2",
    "@react-native-async-storage/async-storage": "^2.1.1",
    "@react-navigation/bottom-tabs": "^7.3.10",
    "@react-navigation/native": "^7.0.14",
    "@stripe/stripe-react-native": "0.63.0",
    "dotenv": "^16.4.7",
    "expo": "^55.0.32",
    "expo-asset": "~55.0.20",
    "expo-blur": "~55.0.18",
    "expo-constants": "~55.0.17",
    "expo-dev-client": "~55.0.41",
    "expo-device": "~55.0.21",
    "expo-file-system": "~55.0.26",
    "expo-font": "~55.0.8",
    "expo-haptics": "~55.0.18",
    "expo-linking": "~55.0.17",
    "expo-notifications": "~55.0.27",
    "expo-router": "~55.0.18",
    "expo-secure-store": "~55.0.18",
    "expo-splash-screen": "~55.0.25",
    "expo-status-bar": "~55.0.6",
    "expo-symbols": "~55.0.9",
    "expo-system-ui": "~55.0.22",
    "expo-web-browser": "~55.0.20",
    "jwt-decode": "^4.0.0",
    "query-string": "^7.1.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-async-storage": "^0.0.1",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-purchases": "^8.9.5",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.16.0",
    "react-native-worklets": "0.7.4",
    "ts-node": "^10.9.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/jest": "^29.5.12",
    "@types/react": "~19.2.10",
    "@types/react-test-renderer": "^18.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~55.0.1",
    "jest": "^29.2.1",
    "jest-expo": "~55.0.22",
    "react-test-renderer": "19.0.0",
    "typescript": "^5.8.2"
  },
  "private": true,
  "overrides": {
    "@expo/metro-config": {
      "postcss": "^8.5.23"
    }
  }
}
