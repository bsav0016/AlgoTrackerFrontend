{
  "name": "algotracker",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watchAll",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "build-prod": "eas build --profile production"
  },
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    },
    "testPathIgnorePatterns": [
      "/node_modules/"
    ]
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@openspacelabs/react-native-zoomable-view": "2.4.2",
    "@react-native-async-storage/async-storage": "^2.1.1",
    "@stripe/stripe-react-native": "0.81.0",
    "dotenv": "^16.4.7",
    "expo": "~58.0.22",
    "expo-asset": "~58.0.18",
    "expo-blur": "~58.0.5",
    "expo-constants": "~58.0.13",
    "expo-dev-client": "~58.0.18",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.11",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-linking": "~58.0.15",
    "expo-notifications": "~58.1.7",
    "expo-router": "~58.0.29",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.6",
    "jwt-decode": "^4.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-async-storage": "^0.0.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-purchases": "^8.9.5",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.0",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0",
    "ts-node": "^10.9.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/jest": "30.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "~19.3.0",
    "@types/react-test-renderer": "^19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.13",
    "react-test-renderer": "19.0.0",
    "typescript": "~6.0.3"
  },
  "private": true,
  "overrides": {
    "@expo/metro-config": {
      "postcss": "^8.5.23"
    },
    "zod": "^4.6.6"
  }
}
