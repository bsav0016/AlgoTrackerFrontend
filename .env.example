# Copy to .env (git-ignored) and adjust. Expo loads it automatically on `npm start`;
# restart with `npx expo start --clear` after changing it.

# Address of the AlgoTracker backend, with the scheme and port.
#  - iOS simulator / web:      http://localhost:8000/
#  - Android emulator:         http://10.0.2.2:8000/
#  - Physical phone on Wi-Fi:  http://<your computer's LAN IP>:8000/
# Defaults to http://localhost:8000/ when unset.
API_URL=http://localhost:8000/

# Stripe *publishable* test key (pk_test_...), from your Stripe dashboard.
# Needed only to try the card-deposit screen. Never put a secret key (sk_...) here.
STRIPE_PUBLIC_KEY=

# Production builds (EAS profile "production") use the deployed API and key automatically.
# To override for a build, set API_URL / STRIPE_PUBLIC_KEY in the EAS build environment.
